# EDGEGUARD AI — backend environment
# Copy to .env for local reference, or set these in your hosting provider.
# The FastAPI process reads its configuration from the real environment.

# Where uploads, fitted preprocessors, models, reports and SQLite live.
EDGEGUARD_DATA_DIR=./data/edgeguard
# Optional explicit SQLite path (defaults inside EDGEGUARD_DATA_DIR).
# EDGEGUARD_DB_PATH=./data/edgeguard/edgeguard.sqlite3

# Comma-separated browser origins allowed to call the API.
EDGEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload and Kaggle archive limits.
EDGEGUARD_MAX_UPLOAD_MB=512
EDGEGUARD_MAX_KAGGLE_MB=2048

# Set to 1 only for tests / CLI usage; keep 0 in serving deployments.
EDGEGUARD_SYNC_JOBS=0

# Kaggle credentials — backend only. Never put these in VITE_* variables.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional if kaggle.json lives somewhere other than ~/.kaggle/kaggle.json
# KAGGLE_CONFIG_DIR=/secure/kaggle
